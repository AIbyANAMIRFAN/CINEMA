# Copy to .env.local for local development. Every variable here is server-only:
# none are prefixed NEXT_PUBLIC_, so none are ever sent to the browser.

# --- Database (Neon via Vercel Marketplace sets these automatically) ---
# Pooled connection (PgBouncer) used by the app at runtime.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection used only by migrations and seeding.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# 32+ random characters, e.g. `openssl rand -base64 48`. Different per environment.
AUTH_SECRET=

# --- Stripe (test mode: sk_test_..., whsec_...) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduled hold cleanup (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=

# --- Optional ---
# Public base URL for payment redirects. On Vercel this is derived automatically.
APP_URL=http://localhost:3000
# Used by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@cinebook.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
